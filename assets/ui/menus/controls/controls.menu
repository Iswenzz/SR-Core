#include "ui/components/base.inc"

// The binding pages open beside the rail; Multiplayer is the mod's own controls_multi page.
#define CONTROLS_PAGE(id, y, label, page) \
	RAIL_PAGE(id, 10, y, (SR_NAV_W - 20), 28, label, page, open page;)

{
	menuDef
	{
		name			"main_controls"
		rect			SR_WINDOW_RECT
		fullScreen		0
		focusColor		COLOR_FOCUSED
		forecolor		1 1 1 0.04
		soundloop		""

		onOpen
		{
			setLocalVarBool ui_showApply 0;
			setLocalVarInt ui_rail_hover 0;

			CLOSE_SERVERBROWSER;
			CLOSE_CREATE_SERVER;
			CLOSE_MODS;
			CLOSE_PROFILE;

			setLocalVarBool ui_hideBack "1";
		}

		onClose
		{
			setLocalVarBool ui_hideBack "0";
		}

		onESC
		{
			close self;
		}

		RAIL_FILL(0, 0, SR_WINDOW_W, SR_WINDOW_H, SR_WINDOW_BACKCOLOR)
		RAIL_PANEL(SR_NAV_W, SR_WINDOW_H, "Controls")
		CONTROLS_PAGE(1, 58, "Look", options_look)
		CONTROLS_PAGE(2, 90, "Move", options_move)
		CONTROLS_PAGE(3, 122, "Combat", options_shoot)
		CONTROLS_PAGE(4, 154, "Interact", options_misc)
		CONTROLS_PAGE(5, 186, "Multiplayer", options_mod)
	}
}
