#include "ui/components/base.inc"

// The pages open beside the rail; Speedrun is the in-game sr_settings page.
#define OPTIONS_PAGE(id, y, label, page, script) \
	RAIL_PAGE(id, 10, y, (SR_NAV_W - 20), 28, label, page, script)

{
    menuDef
	{
		name			"main_options"
		rect			SR_WINDOW_RECT
		fullScreen		0
		focusColor		COLOR_FOCUSED
		soundloop		""
		backcolor		1 1 1 0.04

		onOpen
		{
			setLocalVarBool ui_showApply 0;
			setLocalVarBool ui_showTextureApply 0;
			setLocalVarInt ui_rail_hover 0;

			CLOSE_SERVERBROWSER;
			CLOSE_CREATE_SERVER;
			CLOSE_MODS;
			CLOSE_PROFILE;

			setLocalVarBool ui_hideBack "1";
		}

		onClose
		{
			setLocalVarBool ui_hideBack "0";
		}

		onESC
		{
			close self;
		}

		RAIL_FILL(0, 0, SR_WINDOW_W, SR_WINDOW_H, SR_WINDOW_BACKCOLOR)
		RAIL_PANEL(SR_NAV_W, SR_WINDOW_H, "Settings")
		OPTIONS_PAGE(1, 58, "Speedrun", sr_settings, CLOSE_ALL_OPTIONS; open sr_settings;)
		OPTIONS_PAGE(2, 90, "Graphics", options_graphics, close sr_settings; open options_graphics;)
		OPTIONS_PAGE(3, 122, "Sound", options_sound, close sr_settings; open options_sound;)
		OPTIONS_PAGE(4, 154, "Game", options_game, close sr_settings; open options_game;)
		OPTIONS_PAGE(5, 186, "Mute Players", muteplayer, close sr_settings; open muteplayer;)
	}
}
